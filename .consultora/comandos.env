# Comandos del proyecto (ADR-0007 de la consultora, decisión 2). La CI y los workers usan exactamente estos.
# Obligatorios en un proyecto: FORMATO_CHECK, LINT, TESTS. Los demás pueden quedar vacíos si no aplican.
# Mientras los tres obligatorios estén vacíos, la CI saltea los pasos del proyecto con un aviso (fase de Inicio, sin
# stack decidido). Con uno cargado, se exigen los tres. Antes de la Puerta 2 tienen que estar completos.
INSTALAR=""            # p. ej. "npm ci"
FORMATO_CHECK=""       # p. ej. "npx prettier --check ."
LINT=""                # p. ej. "npx eslint ."
TIPOS=""               # p. ej. "npx tsc --noEmit"
TESTS=""               # unitarias + aceptación, p. ej. "npm test"
TESTS_INTEGRACION=""   # solo si hay persistencia o servicios externos
COBERTURA=""           # se publica en el resumen del job; no bloquea
DEPLOY_STAGING=""
DEPLOY_PRODUCCION=""   # recibe VERSION=vX.Y.Z
SMOKE=""               # recibe ENTORNO=staging|produccion
